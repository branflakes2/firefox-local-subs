{
  "manifest_version": 2,
  "name": "Channel Feed for YouTube",
  "version": "1.1.1",
  "description": "Follow YouTube channels without an account. Replaces the YouTube homepage with the latest videos from your own channel list.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-channel-feed@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "https://www.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Manage channels",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
